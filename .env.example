# Copy to .env, fill in what you need and load it with:  set -a; source .env; set +a
# Never commit .env. Every script reads these from the environment.

# --- Data ---
# Expanded maritime dataset: Mother/, D1/, D2/, D3/, control/
MARITIME_DATA_ROOT=/data/Maritime_RGB_Expanded_20261008
# Jev master table used by dataset/d3x10/build_d3x10.py (made by quality_check/thesis_report.py)
JEV_MASTER_TABLE=quality_check/thesis_data/2026-10-19_095519Z_rules_v4_full_mother/master_table.csv

# --- x4 training: which experiment ---
MARITIME_DATASET=d3            # d1, d2 or d3

# --- Slurm runs (training/x4/ops, training/x10/ops) ---
PROJECT_DIR=/home/<user>/maritime-swinir-run      # run folder: copy of training/x4 or training/x10
SCRATCH_DIR=/scratch/<user>/maritime-swinir-run   # fast disk: staged data, venv, run state, caches
DATA_DIR=/home/<user>/Maritime_D3x10_1m10m        # x10 only: the D3x10 dataset

# --- Jev check (quality_check/) ---
TYPESAFE_API_KEY=

# --- Google Cloud (only for the dataset acquisition and release scripts) ---
GCP_PROJECT=
GCS_BUCKET=
GCS_PILOT_BUCKET=

# --- Re-running the archived comparisons and analysis (evaluation/) ---
RUN_ARCHIVE=                    # archive folder of one run, e.g. ".../D1 run"
D3_ARCHIVE=                     # archive folder of the D3 run
MARITIME_ARCHIVE_ROOT=          # folder that holds all run archives and "Jev check"
ANALYSIS_OUTPUT=analysis_output
